# ArtDex environment — copy to .env.local (gitignored) and fill in.
# Stack: DynamoDB + Bedrock (Claude vision) + S3 + cookie anon auth. No Aurora, no Clerk.

# --- AWS credentials ---
# Local dev: easiest to leave these blank and use ~/.aws/credentials (default chain).
# These plain AWS_* names work locally but DO NOT work on Vercel — Lambda reserves
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION and shadows them at runtime.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- AWS credentials on Vercel (prefixed to dodge the Lambda reserved names) ---
# Set THESE in the Vercel dashboard instead of the AWS_* ones above. See
# src/lib/aws/credentials.ts. ARTDEX_AWS_REGION is optional (defaults us-east-1).
ARTDEX_AWS_ACCESS_KEY_ID=
ARTDEX_AWS_SECRET_ACCESS_KEY=
ARTDEX_AWS_REGION=us-east-1

# --- Bedrock (recognition) ---
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- S3 (selfie keepsakes) ---
S3_BUCKET=artdex-images-525033346195

# --- Demo / dev only (leave unset in production) ---
# Override geolocation so the capture flow can be demoed from a desk: "lat,lon".
# 例:MoMA "40.7614,-73.9776" / V&A "51.4966,-0.1719"。设它即可在桌面演示 GPS 选馆 +
# 传奇 150m 定位门(否则真机在国内,最近馆数千公里外,传奇会被正确拦下)。
NEXT_PUBLIC_MOCK_LOCATION=
# Seed a sample collection without an AWS backend (=1 to enable).
NEXT_PUBLIC_MOCK_COLLECTION=
# Suppress the "looks like a reproduction" warning (=1 to disable the print/screen
# check). Handy when demoing from a printout or a screen. Off by default so
# deployed builds keep flagging reproductions.
DISABLE_REPRO_CHECK=
# Act as a specific pre-seeded user on every request (no cookie fiddling), e.g.
# DEMO_USER_ID=demo-hero shows the polished demo account (7-city map + Starry Night
# moment timeline). Auto-disabled in production. Seed it via scripts/seedDemoHero.ts.
DEMO_USER_ID=
