# ArtDex environment — copy to .env.local (gitignored) and fill in.
# Stack: DynamoDB + Bedrock (Claude vision) + S3 + cookie anon auth. No Aurora, no Clerk.

# --- AWS credentials (standard SDK chain) ---
# Local dev can instead use ~/.aws/credentials. On Vercel, set these two as env vars.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Bedrock (recognition) ---
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- S3 (selfie keepsakes) ---
S3_BUCKET=artdex-images-525033346195

# --- Demo / dev only (leave unset in production) ---
# Override geolocation so the capture flow can be demoed from a desk: "lat,lon".
NEXT_PUBLIC_MOCK_LOCATION=
# Seed a sample collection without an AWS backend (=1 to enable).
NEXT_PUBLIC_MOCK_COLLECTION=
